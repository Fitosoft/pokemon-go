# Copy to backup.env, keep it local and never commit it.
# Use your own project reference and session pooler hostname.
PROJECT_REF="replace-with-your-project-ref"
export PGHOST="replace-with-your-session-pooler-host"
export PGPORT="5432"
export PGDATABASE="postgres"
export PGUSER="postgres.$PROJECT_REF"
export PGSSLMODE="require"
export PGCONNECT_TIMEOUT="15"
export PGPASSFILE="$HOME/.pgpass"
PG_BIN="/usr/lib/postgresql/17/bin"
BACKUP_DIR="$HOME/pokemon-go-backups"
BACKUP_SCHEMAS="pogo pogo_meta pogo_poc pogo_poc_restore"
